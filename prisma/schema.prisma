generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String          @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role            @default(USER)
  accounts             Account[]
  sessions             Session[]
  products             Product[]
  orders               Order[]
  reviews              Review[]
  carts                Cart[]
  Authenticator        Authenticator[]
  gymMembership        GymMembership?
  memberCard           MemberCard?
  classRegistrations   ClassRegistration[]
  blogPosts            BlogPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  USER
  ADMIN
}

model Account {
  id                  String   @id @default(cuid())
  userId              String
  type                String
  provider            String
  providerAccountId   String
  refresh_token       String?
  access_token        String?
  expires_at          Int?
  token_type          String?
  scope               String?
  id_token            String?
  session_state       String?
  refresh_token_expires_in Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  ipAddress    String?
  userAgent    String?

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expires])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@index([expires])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
  @@index([userId])
}

model Product {
  id            String      @id @default(cuid())
  name          String
  description   String
  price         Int
  originalPrice Int?
  stock         Int          @default(0)
  imageUrl      String?
  rating        Float        @default(0)
  reviewsCount  Int          @default(0)
  badge         String?
  categoryId    String?
  userId        String

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  reviews    Review[]
  orderItems OrderItem[]
  cartItems  CartItem[]   

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  products  Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Cart {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int       @default(1)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())  
  updatedAt DateTime @updatedAt       
}

model Order {
  id        String      @id @default(cuid())
  userId    String
  status    OrderStatus @default(PENDING)
  total     Int
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     OrderItem[]
  payment   Payment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  COMPLETED
  CANCELED
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())  
  updatedAt DateTime @updatedAt       
}

model Payment {
  id            String         @id @default(cuid())
  orderId       String         @unique
  amount        Int
  method        String
  status        PaymentStatus  @default(PENDING)
  transactionId String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String
  rating    Int      @default(5)
  comment   String?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Gym-Specific Models ────────────────────────────────────────────────────

model MembershipPlan {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  price       Int
  description String
  features    Json
  popular     Boolean         @default(false)
  color       String?
  borderColor String?
  memberships GymMembership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GymMembership {
  id         String           @id @default(cuid())
  userId     String           @unique
  planId     String
  status     MembershipStatus @default(ACTIVE)
  startDate  DateTime
  endDate    DateTime
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan       MembershipPlan   @relation(fields: [planId], references: [id])
  memberCard MemberCard?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
  PENDING
}

model MemberCard {
  id           String        @id @default(cuid())
  membershipId String        @unique
  userId       String        @unique
  barcodeCode  String        @unique @default(cuid())
  membership   GymMembership @relation(fields: [membershipId], references: [id])
  user         User          @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Coach {
  id                String         @id @default(cuid())
  name              String
  slug              String         @unique
  title             String
  bio               String
  imageUrl          String
  specialties       String[]
  certifications    String[]
  experience        Int
  instagram         String?
  featured          Boolean        @default(false)
  isPersonalTrainer Boolean        @default(false)
  pricePerSession   Int?
  achievements      String?
  classSessions     ClassSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClassType {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String
  imageUrl    String?
  duration    Int
  level       ClassLevel     @default(ALL_LEVELS)
  color       String?
  colorSolid  String?
  icon        String?
  benefits    String[]
  sessions    ClassSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ClassLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

model ClassSession {
  id            String              @id @default(cuid())
  classTypeId   String
  coachId       String
  date          DateTime
  startTime     String
  endTime       String
  capacity      Int
  price         Int
  room          String?
  status        SessionStatus       @default(UPCOMING)
  classType     ClassType           @relation(fields: [classTypeId], references: [id])
  coach         Coach               @relation(fields: [coachId], references: [id])
  registrations ClassRegistration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SessionStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELED
}

model ClassRegistration {
  id        String             @id @default(cuid())
  userId    String
  sessionId String
  status    RegistrationStatus @default(REGISTERED)
  user      User               @relation(fields: [userId], references: [id])
  session   ClassSession       @relation(fields: [sessionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, sessionId])
}

enum RegistrationStatus {
  REGISTERED
  ATTENDED
  CANCELED
  NO_SHOW
}

model BlogPost {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  excerpt     String
  content     String
  imageUrl    String?
  authorId    String
  authorName  String
  readTime    Int          @default(5)
  category    BlogCategory @default(NEWS)
  published   Boolean      @default(false)
  featured    Boolean      @default(false)
  author      User         @relation(fields: [authorId], references: [id])
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum BlogCategory {
  NEWS
  TIPS
  NUTRITION
  WORKOUT
  EVENTS
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String          @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  password      String?
  role          Role            @default(USER)
  accounts             Account[]
  sessions             Session[]
  products             Product[]
  orders               Order[]
  reviews              Review[]
  carts                Cart[]
  Authenticator        Authenticator[]
  gymMembership        GymMembership?
  memberCard           MemberCard?
  classRegistrations   ClassRegistration[]
  blogPosts            BlogPost[]
  otps                 Otp[]
  ptBookings           PTBooking[]
  notifications        Notification[]
  paymentIntents       PaymentIntent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Otp {
  id         String    @id @default(cuid())
  userId     String
  code       String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

enum Role {
  USER
  ADMIN
}

model Account {
  id                  String   @id @default(cuid())
  userId              String
  type                String
  provider            String
  providerAccountId   String
  refresh_token       String?
  access_token        String?
  expires_at          Int?
  token_type          String?
  scope               String?
  id_token            String?
  session_state       String?
  refresh_token_expires_in Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  ipAddress    String?
  userAgent    String?

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expires])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@index([expires])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
  @@index([userId])
}

model Product {
  id            String      @id @default(cuid())
  name          String
  description   String
  price         Int
  originalPrice Int?
  stock         Int          @default(0)
  imageUrl      String?
  rating        Float        @default(0)
  reviewsCount  Int          @default(0)
  badge         String?
  categoryId    String?
  userId        String

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  reviews    Review[]
  orderItems OrderItem[]
  cartItems  CartItem[]   

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  products  Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Cart {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int       @default(1)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())  
  updatedAt DateTime @updatedAt       
}

model Order {
  id        String      @id @default(cuid())
  userId    String
  status    OrderStatus @default(PENDING)
  total     Int
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     OrderItem[]
  payment   Payment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  COMPLETED
  CANCELED
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())  
  updatedAt DateTime @updatedAt       
}

model Payment {
  id            String         @id @default(cuid())
  orderId       String         @unique
  amount        Int
  method        String
  status        PaymentStatus  @default(PENDING)
  transactionId String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum ReviewTargetType {
  PRODUCT
  CLASS_SESSION
  PT_BOOKING
}

model Review {
  id             String           @id @default(cuid())
  userId         String
  targetType     ReviewTargetType
  productId      String?
  classSessionId String?
  ptBookingId    String?
  rating         Int              @default(5)
  comment        String?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  product      Product?      @relation(fields: [productId], references: [id], onDelete: Cascade)
  classSession ClassSession? @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  ptBooking    PTBooking?    @relation(fields: [ptBookingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@unique([userId, classSessionId])
  @@unique([userId, ptBookingId])
  @@index([productId])
  @@index([classSessionId])
  @@index([ptBookingId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  read      Boolean          @default(false)
  starred   Boolean          @default(false)
  sourceId  String?
  actionUrl String?
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, type, sourceId])
  @@index([userId, createdAt])
  @@index([userId, read])
}

// PROMO exists for UI/icon parity with the notifications page's type filters,
// but no write path in this codebase ever produces one — broadcast-to-all-users
// notifications ("new slot available", promos) are out of scope.
enum NotificationType {
  BOOKING
  PAYMENT
  PT
  PROMO
  SYSTEM
}

enum PaymentIntentType {
  SHOP
  CLASS_BOOKING
  PT_BOOKING
  MEMBERSHIP
}

enum PaymentIntentStatus {
  PENDING
  SUCCESS
  FAILED
}

// Created the moment a user clicks "Bayar" — id doubles as the Midtrans
// order_id. Domain rows (Order, ClassRegistration, PTBooking, GymMembership)
// are only created once this flips to SUCCESS (see src/lib/paymentIntent.ts),
// confirmed either by the Midtrans webhook or by actively polling Midtrans's
// status API — never by the client alone.
model PaymentIntent {
  id        String              @id @default(cuid())
  userId    String
  type      PaymentIntentType
  status    PaymentIntentStatus @default(PENDING)
  amount    Int
  payload   Json
  snapToken String?
  resultRef String?
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

// ─── Gym-Specific Models ────────────────────────────────────────────────────

model MembershipPlan {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  price       Int
  description String
  features    Json
  popular     Boolean         @default(false)
  color       String?
  borderColor String?
  memberships GymMembership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GymMembership {
  id         String           @id @default(cuid())
  userId     String           @unique
  planId     String
  status     MembershipStatus @default(ACTIVE)
  startDate  DateTime
  endDate    DateTime
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan       MembershipPlan   @relation(fields: [planId], references: [id])
  memberCard MemberCard?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
  PENDING
}

model MemberCard {
  id           String        @id @default(cuid())
  membershipId String        @unique
  userId       String        @unique
  barcodeCode  String        @unique @default(cuid())
  membership   GymMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Coach {
  id                String         @id @default(cuid())
  name              String
  slug              String         @unique
  title             String
  bio               String
  imageUrl          String
  specialties       String[]
  certifications    String[]
  experience        Int
  instagram         String?
  featured          Boolean        @default(false)
  isPersonalTrainer Boolean        @default(false)
  pricePerSession   Int?
  achievements      String?
  classSessions     ClassSession[]
  ptBookings        PTBooking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PTBooking {
  id            String          @id @default(cuid())
  userId        String
  coachId       String
  packageName   String
  sessionsTotal Int
  sessionsUsed  Int             @default(0)
  price         Int
  startDate     DateTime
  endDate       DateTime
  status        PTBookingStatus @default(ACTIVE)
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  coach         Coach           @relation(fields: [coachId], references: [id])
  reviews       Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PTBookingStatus {
  ACTIVE
  COMPLETED
  CANCELED
}

model ClassType {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String
  imageUrl    String?
  duration    Int
  color       String?
  colorSolid  String?
  icon        String?
  benefits    String[]
  sessions    ClassSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClassSession {
  id            String              @id @default(cuid())
  classTypeId   String
  coachId       String
  date          DateTime
  startTime     String
  endTime       String
  capacity      Int
  price         Int
  room          String?
  status        SessionStatus       @default(UPCOMING)
  classType     ClassType           @relation(fields: [classTypeId], references: [id])
  coach         Coach               @relation(fields: [coachId], references: [id])
  registrations ClassRegistration[]
  reviews       Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SessionStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELED
}

model ClassRegistration {
  id        String             @id @default(cuid())
  userId    String
  sessionId String
  status    RegistrationStatus @default(REGISTERED)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  session   ClassSession       @relation(fields: [sessionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, sessionId])
}

enum RegistrationStatus {
  REGISTERED
  ATTENDED
  CANCELED
  NO_SHOW
}

model BlogPost {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  excerpt     String
  content     String
  imageUrl    String?
  authorId    String
  authorName  String
  readTime    Int          @default(5)
  category    BlogCategory @default(NEWS)
  published   Boolean      @default(false)
  featured    Boolean      @default(false)
  author      User         @relation(fields: [authorId], references: [id])
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum BlogCategory {
  NEWS
  TIPS
  NUTRITION
  WORKOUT
  EVENTS
}

// Authjs
AUTH_SECRET=

// Google OAuth (src/lib/auth.ts) — create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

// Gmail SMTP for OTP verification email (src/lib/mailer.ts) — use a Google App Password, not your login password
GMAIL_USER=
GMAIL_APP_PASSWORD=

// Prisma "(prisma - schema.prisma)"
DATABASE_URL=
DIRECT_URL=

// Supabase "(src/utils/supabase - supabase. + (server.ts | client.ts | middleware.ts))"
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

// SEO (src/lib/seo.ts) — production URL used for metadataBase, sitemap, canonical links
NEXT_PUBLIC_SITE_URL=